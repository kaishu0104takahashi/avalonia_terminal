<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:avalonia_terminal.ViewModels"
             x:Class="avalonia_terminal.Views.SimpleInspectView"
             x:DataType="vm:SimpleInspectViewModel">

    <UserControl.Styles>
        <Style Selector="Button.BlueBtn">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.BlueBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#118ADD"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.BlueBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#005599"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.GreenBtn">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.GreenBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#388E3C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.GreenBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1B5E20"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.OrangeBtn">
            <Setter Property="Background" Value="#EF6C00"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.OrangeBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F57C00"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.OrangeBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#E65100"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.GrayBtn">
            <Setter Property="Background" Value="#666666"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.GrayBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#777777"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.GrayBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*, 350" Background="#202020">
        
        <Border Grid.Column="0" Margin="10" BorderBrush="#444" BorderThickness="2" Background="Black">
            <Panel>
                <Image Source="{Binding Main.CameraImage}" 
                       IsVisible="{Binding !IsCaptured}" 
                       Stretch="Uniform"/>
                
                <Image Source="{Binding CapturedImage}" 
                       IsVisible="{Binding IsCaptured}" 
                       Stretch="Uniform"/>
                
                <TextBlock Text="NO SIGNAL" 
                           IsVisible="{Binding Main.CameraImage, Converter={x:Static ObjectConverters.IsNull}}"
                           Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30"/>
            </Panel>
        </Border>

        <Border Grid.Column="1" Background="#303030" Padding="20">
            <Grid RowDefinitions="Auto, *, Auto">
                
                <Border Grid.Row="0" Background="#404040" Padding="15" CornerRadius="8" Margin="0,0,0,20">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="20" TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>

                <StackPanel Grid.Row="1" Spacing="20" VerticalAlignment="Center">
                    
                    <Button Command="{Binding CaptureCommand}" IsVisible="{Binding IsCaptureButtonVisible}"
                            Content="撮影" Classes="BlueBtn"
                            HorizontalAlignment="Stretch" Height="100" FontSize="32" FontWeight="Bold"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="10"/>

                    <Button Command="{Binding SaveCommand}" IsVisible="{Binding IsCaptured}"
                            Content="保存する" Classes="GreenBtn"
                            HorizontalAlignment="Stretch" Height="100" FontSize="32" FontWeight="Bold"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="10"/>

                    <Button Command="{Binding RetakeCommand}" IsVisible="{Binding IsCaptured}"
                            Content="撮り直し" Classes="OrangeBtn"
                            HorizontalAlignment="Stretch" Height="80" FontSize="24"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="10"/>
                </StackPanel>

                <Button Grid.Row="2" Command="{Binding BackCommand}"
                        Content="キャンセル / 戻る" Classes="GrayBtn"
                        HorizontalAlignment="Stretch" Height="60" FontSize="20"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CornerRadius="8"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
