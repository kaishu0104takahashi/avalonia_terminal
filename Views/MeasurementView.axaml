<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:avalonia_terminal.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="avalonia_terminal.Views.MeasurementView"
             x:DataType="vm:MeasurementViewModel">

    <Grid Background="#1E1E1E">
        <Border VerticalAlignment="Top" Background="#80000000" Padding="15" ZIndex="10">
            <Grid>
                <Button Content="＜ 戻る" Command="{Binding BackCommand}" 
                        HorizontalAlignment="Left" Background="#444" Foreground="White" FontSize="18"/>
                <TextBlock Text="測定モード" Foreground="White" FontSize="24" FontWeight="Bold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="*, 750" Margin="0,60,0,0">
            
            <Grid Grid.Column="0" Background="Black" ClipToBounds="True">
                <Panel>
                    <Image Source="{Binding LiveImage}" Stretch="Uniform" IsVisible="{Binding !HasResult}"/>
                    
                    <Image Source="{Binding CapturedImage}" Stretch="Uniform" IsVisible="{Binding HasResult}"/>
                    
                    <Border BorderBrush="#00FF00" BorderThickness="2" Width="400" Height="300" 
                            IsVisible="{Binding !HasResult}" Opacity="0.5" CornerRadius="10">
                        <TextBlock Text="基板をセットして実行" Foreground="#00FF00" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                    </Border>
                </Panel>

                <Button Content="測定実行" Command="{Binding ExecuteMeasurementCommand}"
                        IsVisible="{Binding !HasResult}" IsEnabled="{Binding !IsMeasuring}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"
                        Width="200" Height="80" FontSize="28" FontWeight="Bold" CornerRadius="40"
                        Background="#007ACC" Foreground="White" BorderBrush="White" BorderThickness="2"/>
                
                <Button Content="再測定" Command="{Binding RetryCommand}"
                        IsVisible="{Binding HasResult}"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,30"
                        Width="200" Height="80" FontSize="28" FontWeight="Bold" CornerRadius="40"
                        Background="#EF6C00" Foreground="White" BorderBrush="White" BorderThickness="2"/>
            </Grid>

            <Border Grid.Column="1" Background="#2D2D30" BorderBrush="#3E3E42" BorderThickness="1,0,0,0" Padding="10">
                <Grid RowDefinitions="Auto, *">
                    <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,10">
                        <TextBlock Text="測定結果一覧" Foreground="#AAAAAA" FontSize="20" FontWeight="Bold"/>
                        <Separator Background="#3E3E42" Height="2"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" x:Name="ResultScroll"
                                  PointerPressed="OnScrollPointerPressed" 
                                  PointerMoved="OnScrollPointerMoved" 
                                  PointerReleased="OnScrollPointerReleased">
                        <ItemsControl ItemsSource="{Binding DetectionItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#3E3E42" Margin="0,0,0,10" CornerRadius="5" Padding="8">
                                        <Grid ColumnDefinitions="220, *">
                                            <Border Grid.Column="0" Width="200" Height="200" Background="Black" CornerRadius="4" ClipToBounds="True">
                                                <Image Source="{Binding CroppedImage}" Stretch="Uniform"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                                <TextBlock Text="{Binding Label}" Foreground="#007ACC" FontWeight="Bold" FontSize="26"/>
                                                <TextBlock Text="{Binding FormattedValue}" Foreground="White" FontSize="34" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <TextBlock Grid.Row="1" Text="測定結果がここに表示されます" 
                               IsVisible="{Binding !HasResult}"
                               Foreground="#555" FontSize="18" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                               
                    <TextBlock Grid.Row="1" Text="{Binding ResultText}" 
                               IsVisible="{Binding IsMeasuring}"
                               Foreground="#00FF00" FontSize="24" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsMeasuring}" Background="#AA000000" ZIndex="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="30">
                <TextBlock Text="測定中..." Foreground="White" FontSize="48" FontWeight="Bold"/>
                <Button Content="中断" Command="{Binding CancelMeasurementCommand}"
                        Width="200" Height="70" FontSize="24" FontWeight="Bold"
                        Background="#D32F2F" Foreground="White" CornerRadius="10"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
